import train:"de.simone.btree.logistic.TrainTask"
import createSquad:"de.simone.btree.logistic.CreateSquadTask"
import loadBunkers:"de.simone.btree.logistic.LoadBunkersTask"
import repairUnit:"de.simone.btree.logistic.RepairUnitTask"
import isSquadNeeded:"de.simone.btree.logistic.IsSquadNeededCondition"

selector
    sequence
        # build the bare minimum infrastructure
        train unitType:"Terran_SCV" increase:2
        train unitType:"Terran_Refinery" total:1
        train unitType:"Terran_SCV" increase:2

        # create defensive bunkers and load them with marines (train marine first)
        train unitType:"Terran_Barracks" total:1 
        repeat times:2
            sequence
                train unitType:"Terran_Marine" increase:4
                train unitType:"Terran_Bunker" total:1 
                loadBunkers

        train upgradeType:"U_238_Shells" total:1
        train unitType:"Terran_Engineering_Bay" total:1

        # Create a patrol squad
        train unitType:"Terran_Marine" increase:4
        createSquad type:"Patrol" members:"4*Terran_Marine"

    repeat
        selector
            ## repair infrastructure
            sequence
                repairUnit
                train unitType:"Terran_Marine" total:4
                train unitType:"Terran_Bunker" total:1 
                loadBunkers
                wait seconds:10

            # resupply squads
            sequence
                isSquadNeeded type:"Patrol"
                train unitType:"Terran_Marine" total:4
                createSquad type:"Patrol" members:"4*Terran_Marine"
                wait seconds:10


        # Mechanized squad
        # sequence
        #     trainForceTo        level:3
        #     train               unitType:"Terran_SCV" total:1
        #     train               unitType:"Terran_Marine" total:10
        #     train               unitType:"Terran_Medic" total:4
        #     train               unitType:"Terran_Firebat" total:5
        #     train               unitType:"Terran_Siege_Tank_Tank_Mode" total:5
        #     train               unitType:"Terran_Goliath" total:5
        #     createSquad         type:"Combat" members:"Terran_SCV,4*Terran_Medic,5*Terran_Firebat,5*Terran_Siege_Tank_Tank_Mode,5*Terran_Goliath,10*Terran_Marine"