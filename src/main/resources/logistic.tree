import train:"de.simone.btree.logistic.TrainTask"
import createSquad:"de.simone.btree.logistic.CreateSquadTask"
import loadBunkers:"de.simone.btree.logistic.LoadBunkersTask"
import repairUnit:"de.simone.btree.logistic.RepairUnitTask"
import isSquadNeeded:"de.simone.btree.logistic.IsSquadNeededCondition"
import isBunkerNeeded:"de.simone.btree.logistic.IsBunkerNeededCondition"
import debugLogistic:"de.simone.btree.logistic.DebugLogisticTask"
import reSupplySquad:"de.simone.btree.logistic.ReSupplySquadTask"

repeat
    sequence
        # build the bare minimum infrastructure
        train unitType:"Terran_SCV" total:5
        train unitType:"Terran_Refinery" total:1
        train unitType:"Terran_SCV" total:7
        # train unitType:"Terran_Barracks" total:2
        train unitType:"Terran_Barracks" total:1
        # train upgradeType:"U_238_Shells" total:1
        train techType:"Stim_Packs" total:1

        # create defensive bunkers and load them
        # isBunkerNeeded
        # train unitType:"Terran_Bunker" total:1
        # train unitType:"Terran_Marine" total:4
        # loadBunkers
        # train unitType:"Terran_Bunker" total:2
        # train unitType:"Terran_Marine" total:8
        # loadBunkers
        # train unitType:"Terran_Bunker" total:3
        # train unitType:"Terran_Marine" total:12
        # loadBunkers


        # Create a patrol squad
        train unitType:"Terran_Firebat" total:4
        createSquad type:"Patrol" members:"4*Terran_Firebat"

        train unitType:"Terran_Firebat" total:8
        createSquad type:"Patrol" members:"8*Terran_Firebat"

        # Create a strike squad
        # train unitType:"Terran_Medic" total:1
        # train unitType:"Terran_Firebat" total:2
        # train unitType:"Terran_SCV" total:1
        # train unitType:"Terran_Siege_Tank_Tank_Mode" total:2
        # createSquad type:"Strike" members:"Terran_Medic,2*Terran_Firebat,Terran_SCV,2*Terran_Siege_Tank_Tank_Mode"

        ## repair infrastructure
        # repairUnit
        # reSupplySquad
        wait seconds:1